{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".tmp-check",
    "rootDir": "src/shared",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "noEmit": false
  },
  "include": ["src/shared/**/*.ts"]
}
